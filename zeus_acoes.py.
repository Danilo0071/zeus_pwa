def _mem_ler(forcar=False):
    cache = st.session_state.get("_za_mem")
    if cache and not forcar and time.time() - cache["ts"] < 120:
        return cache["fatos"]
    try:
        fatos = json.loads(b2_get(MEM_KEY).decode("utf-8"))
