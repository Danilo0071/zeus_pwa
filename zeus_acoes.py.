_RE_PATH = r"([\w.\-]+(?:/[\w.\-]+)+/?|[\w\-]+\.\w{2,5})"


def _path_do_texto(texto: str) -> str:
    for m in re.finditer(_RE_PATH, texto):
        cand = m.group(1)
        if "@" in texto[max(0, m.start() - 1):m.start()] or re.fullmatch(r"\d+\.\d+", cand):
            continue
        return cand.strip(".,;:").lstrip("/")
    return ""


